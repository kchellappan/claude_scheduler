[Unit]
Description=csched job runner
After=network-online.target csched-poller.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/GithubRepos/claude_scheduler
ExecStart=/usr/bin/python3 -m csched run
Restart=always
RestartSec=20
Environment=CSCHED_MAX_CONCURRENT=1

[Install]
WantedBy=default.target
